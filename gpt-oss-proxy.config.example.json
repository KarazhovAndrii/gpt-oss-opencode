{
  "host": "127.0.0.1",
  "port": 8787,
  "defaultProfile": "custom",
  "logDir": "logs",
  "logContent": false,
  "logRetentionDays": 14,
  "profiles": {
    "custom": {
      "//": "Any OpenAI-compatible provider serving GPT-OSS 20B. Add more profiles like this one under any name; the OpenCode model id gpt-oss/<name> selects them.",
      "baseURL": "http://gpu-box:8000/v1",
      "model": "openai/gpt-oss-20b",
      "apiKeyEnv": "CUSTOM_API_KEY",
      "strategy": "auto",
      "fallbackStrategy": "harmony",
      "stream": true,
      "maxOutputTokens": 8192,
      "contextWindow": 32768,
      "toolDescriptions": "compact"
    },
    "siliconflow": {
      "baseURL": "https://api.siliconflow.com/v1",
      "model": "openai/gpt-oss-20b",
      "apiKeyEnv": "SILICONFLOW_API_KEY",
      "strategy": "harmony",
      "stream": false,
      "maxOutputTokens": 8192,
      "contextWindow": 131072,
      "pricing": {
        "input": 0.04,
        "output": 0.18
      },
      "toolDescriptions": "compact"
    },
    "openwebui": {
      "kind": "openwebui",
      "openwebuiRoute": "auto",
      "baseURL": "http://localhost:8080/api",
      "model": "gpt-oss20b-opencode",
      "apiKeyEnv": "OPENWEBUI_API_KEY",
      "strategy": "auto",
      "fallbackStrategy": "harmony",
      "stream": true,
      "maxOutputTokens": 8192,
      "contextWindow": 32768,
      "extraBody": {},
      "toolDescriptions": "compact",
      "//numCtx": "route \"api\" only: e.g. 32768 is sent as options.num_ctx; on route \"ollama-v1\" set OLLAMA_CONTEXT_LENGTH on the Ollama server instead"
    }
  },
  "limits": {
    "firstByteTimeoutMs": 60000,
    "idleTimeoutMs": 45000,
    "requestTimeoutMs": 180000,
    "transportRetries": 3,
    "rateLimitRetries": 8,
    "rateLimitBackoffMs": 5000,
    "repairAttempts": 2,
    "redundantHints": 2,
    "emptyRetries": 1,
    "maxRedundantPerTurn": 3,
    "maxConsecutiveErrors": 8,
    "maxStepsPerTurn": 60,
    "requestBudgetMs": 420000
  }
}
